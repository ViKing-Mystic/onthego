# ==============================================================================
# OntheGO - Environment Variables Configuration Template
# Copy this file to `.env` or `.env.local` for local development.
# NEVER commit production API keys or service role secrets to version control.
# ==============================================================================

# Application Environment ('development', 'staging', 'production')
VITE_APP_ENV=production

# ------------------------------------------------------------------------------
# Google Gemini API (AI Travel Assistant & Grounded Recommendations)
# Free tier: 15 RPM / 1M TPM (sufficient for 2-traveller Kerala expedition)
# Get a key from: https://aistudio.google.com/
# If unset, the app gracefully falls back to deterministic heuristic advice.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database & Real-Time Sync
# Create a free project at: https://supabase.com/
# Row Level Security (RLS) is strictly enforced in migration 20261014_initial_schema_and_rls.sql
# ------------------------------------------------------------------------------
# Public Supabase URL (safe to expose to client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key (safe to expose to client, all access governed by RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Secret Key (SERVER-SIDE ONLY - for running backend migrations/tests)
# CAUTION: Bypasses RLS. NEVER expose to browser clients or frontend bundles!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_here

# ------------------------------------------------------------------------------
# Open-Meteo & Nominatim (Weather & Geocoding)
# Both services are open-access and require NO API key for standard volumes.
# ------------------------------------------------------------------------------
VITE_WEATHER_API_BASE=https://api.open-meteo.com/v1/forecast
VITE_NOMINATIM_API_BASE=https://nominatim.openstreetmap.org

# ------------------------------------------------------------------------------
# Carto Maps API (Leaflet Vector/Raster Basemaps Tiles)
# High-clarity raster tiles for Kochi-Alleppey coastal expedition route planning.
# Public/demo key: cb1_4itb_1_cf9e5a75cd3fbf7109538e38
# ------------------------------------------------------------------------------
CARTO_API_KEY=cb1_4itb_1_cf9e5a75cd3fbf7109538e38
VITE_CARTO_API_KEY=cb1_4itb_1_cf9e5a75cd3fbf7109538e38

# ------------------------------------------------------------------------------
# Reliability & Offline Simulation
# Set to 'true' to simulate unreliable 2G/3G Kerala coastal network during local QA.
# ------------------------------------------------------------------------------
VITE_SIMULATE_OFFLINE=false
